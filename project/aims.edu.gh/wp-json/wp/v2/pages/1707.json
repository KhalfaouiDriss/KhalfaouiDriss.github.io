13472\" \/><\/figure>\n\n\n\n<figure class=\"wp-block-image size-full\"><img decoding=\"async\" loading=\"lazy\" width=\"5472\" height=\"3648\" src=\"https:\/\/aims.edu.gh\/wp-content\/uploads\/sites\/4\/2025\/11\/IMG_1246.jpg\" alt=\"\" class=\"wp-image-13478\" \/><\/figure>\n\n\n\n<figure class=\"wp-block-image size-full\"><img decoding=\"async\" loading=\"lazy\" width=\"787\" height=\"525\" src=\"https:\/\/aims.edu.gh\/wp-content\/uploads\/sites\/4\/2021\/09\/IMG_1237.png\" alt=\"\" class=\"wp-image-5471\" srcset=\"https:\/\/aims.edu.gh\/wp-content\/uploads\/sites\/4\/2021\/09\/IMG_1237.png 787w, https:\/\/aims.edu.gh\/wp-content\/uploads\/sites\/4\/2021\/09\/IMG_1237-300x200.png 300w, https:\/\/aims.edu.gh\/wp-content\/uploads\/sites\/4\/2021\/09\/IMG_1237-768x512.png 768w, https:\/\/aims.edu.gh\/wp-content\/uploads\/sites\/4\/2021\/09\/IMG_1237-18x12.png 18w\" sizes=\"(max-width: 787px) 100vw, 787px\" \/><\/figure>\n\n\n\n<figure class=\"wp-block-image size-full\"><img decoding=\"async\" loading=\"lazy\" width=\"1080\" height=\"720\" src=\"https:\/\/aims.edu.gh\/wp-content\/uploads\/sites\/4\/2025\/11\/IMG_8643.jpg\" alt=\"\" class=\"wp-image-13473\" \/><\/figure>\n\n\n\n<figure class=\"wp-block-image size-full\"><img decoding=\"async\" loading=\"lazy\" width=\"1080\" height=\"720\" src=\"https:\/\/aims.edu.gh\/wp-content\/uploads\/sites\/4\/2025\/11\/IMG_8151.jpg\" alt=\"\" class=\"wp-image-13476\" \/><\/figure>\n\n\n\n<figure class=\"wp-block-image size-full\"><img decoding=\"async\" loading=\"lazy\" width=\"966\" height=\"655\" src=\"https:\/\/aims.edu.gh\/wp-content\/uploads\/sites\/4\/2025\/11\/Screenshot-2025-11-11-134831.png\" alt=\"\" class=\"wp-image-13480\" \/><\/figure>\n\n\n\n<figure class=\"wp-block-image size-full\"><img decoding=\"async\" loading=\"lazy\" width=\"787\" height=\"525\" src=\"https:\/\/aims.edu.gh\/wp-content\/uploads\/sites\/4\/2021\/09\/IMG_1336.png\" alt=\"\" class=\"wp-image-5478\" srcset=\"https:\/\/aims.edu.gh\/wp-content\/uploads\/sites\/4\/2021\/09\/IMG_1336.png 787w, https:\/\/aims.edu.gh\/wp-content\/uploads\/sites\/4\/2021\/09\/IMG_1336-300x200.png 300w, https:\/\/aims.edu.gh\/wp-content\/uploads\/sites\/4\/2021\/09\/IMG_1336-768x512.png 768w, https:\/\/aims.edu.gh\/wp-content\/uploads\/sites\/4\/2021\/09\/IMG_1336-18x12.png 18w\" sizes=\"(max-width: 787px) 100vw, 787px\" \/><\/figure>\n\n\n\n<figure class=\"wp-block-image size-full\"><img decoding=\"async\" loading=\"lazy\" width=\"3984\" height=\"2656\" src=\"https:\/\/aims.edu.gh\/wp-content\/uploads\/sites\/4\/2025\/11\/10..jpg\" alt=\"\" class=\"wp-image-13474\" \/><\/figure>\n\n\n\n<figure class=\"wp-block-image size-full\"><img decoding=\"async\" loading=\"lazy\" width=\"787\" height=\"525\" src=\"https:\/\/aims.edu.gh\/wp-content\/uploads\/sites\/4\/2021\/09\/IMG_1173.png\" alt=\"\" class=\"wp-image-5489\" srcset=\"https:\/\/aims.edu.gh\/wp-content\/uploads\/sites\/4\/2021\/09\/IMG_1173.png 787w, https:\/\/aims.edu.gh\/wp-content\/uploads\/sites\/4\/2021\/09\/IMG_1173-300x200.png 300w, https:\/\/aims.edu.gh\/wp-content\/uploads\/sites\/4\/2021\/09\/IMG_1173-768x512.png 768w, https:\/\/aims.edu.gh\/wp-content\/uploads\/sites\/4\/2021\/09\/IMG_1173-18x12.png 18w\" sizes=\"(max-width: 787px) 100vw, 787px\" \/><\/figure>\n\n\n\n<figure class=\"wp-block-image size-full\"><img decoding=\"async\" loading=\"lazy\" width=\"1132\" height=\"594\" src=\"https:\/\/aims.edu.gh\/wp-content\/uploads\/sites\/4\/2025\/11\/gmsp_masterclass_2_2.png\" alt=\"\" class=\"wp-image-13475\" \/><\/figure>\n\n\n\n<figure class=\"wp-block-image size-full\"><img decoding=\"async\" loading=\"lazy\" width=\"3984\" height=\"2656\" src=\"https:\/\/aims.edu.gh\/wp-content\/uploads\/sites\/4\/2025\/11\/IMG_6384.jpg\" alt=\"\" class=\"wp-image-13477\" \/><\/figure>\n<\/figure>\n\n\n\n<p class=\"has-red-color has-text-color\"><\/p>\n<\/div><\/div>\n\n\n\n<div class=\"wp-block-advgb-tab advgb-tab-body-container\"><div class=\"advgb-tab-body-header advgb-tab-class-undefined\">APPLY<\/div><div class=\"advgb-tab-_8cc99f-bf advgb-tab-body\" aria-labelledby=\"advgb-tabs-tab3\">\n<p>Application forms should be downloaded from the online application, completed, scanned, and uploaded no later than <strong>5th May 2025<\/strong> by the nominating SHS or the applicant.<\/p>\n\n\n\n<p>Upload of last two terms&#8217; transcripts should be included.<\/p>\n\n\n\n<p><strong>There is no application fee.<\/strong><strong><\/strong><\/p>\n\n\n\n<p>STEPS<\/p>\n\n\n\n<ol type=\"1\">\n<li>Download the 2025 application form <a href=\"https:\/\/aims.edu.gh\/wp-content\/uploads\/sites\/4\/2025\/02\/2025_GMSP_Application_Form.pdf\">HERE<\/a>.<\/li>\n\n\n\n<li>Fill the downloaded form, scan the filled form, scan your two term report cards and save them separately.<\/li>\n\n\n\n<li>&nbsp;Record a 3-minute video highlighting your motivation for applying for the GMSP (guidelines on application link)<\/li>\n\n\n\n<li>Fill the online form (add link) and upload scanned files <a href=\"https:\/\/docs.google.com\/forms\/d\/e\/1FAIpQLSd8LkNelKe3ls29XKS3dWjzsVEO4DaE5OtuKcmjpR5mQpiEdA\/viewform\">HERE.<\/a>&nbsp;<\/li>\n<\/ol>\n\n\n\n<div class=\"wp-block-button\"><a class=\"wp-block-button__link wp-element-button\" href=\"https:\/\/aims.edu.gh\/wp-content\/uploads\/sites\/4\/2025\/03\/GMSP-2025_Poster-Final.pdf\" target=\"_blank\" rel=\"noreferrer noopener\">Download Application Flyer<\/a><\/div>\n<\/div><\/div>\n\n\n\n<div class=\"wp-block-advgb-tab advgb-tab-body-container\"><div class=\"advgb-tab-body-header advgb-tab-class-undefined\"><\/div><div class=\"advgb-tab-_a12200-6c advgb-tab-body\" aria-labelledby=\"advgb-tabs-tab4\">\n<p><\/p>\n<\/div><\/div>\n\n\n\n<div class=\"wp-block-advgb-tab advgb-tab-body-container\"><div class=\"advgb-tab-body-header advgb-tab-class-undefined\"><\/div><div class=\"advgb-tab-_f802fa-b9 advgb-tab-body\" aria-labelledby=\"advgb-tabs-tab5\">\n<p><\/p>\n<\/div><\/div>\n\n\n\n<div class=\"wp-block-advgb-tab advgb-tab-body-container\"><div class=\"advgb-tab-body-header advgb-tab-class-undefined\"><\/div><div class=\"advgb-tab-_9d29c7-ab advgb-tab-body\" aria-labelledby=\"advgb-tabs-tab6\">\n<p><\/p>\n<\/div><\/div>\n\n\n\n<div class=\"wp-block-advgb-tab advgb-tab-body-container\"><div class=\"advgb-tab-body-header advgb-tab-class-undefined\"><\/div><div class=\"advgb-tab-_5cbf5d-ea advgb-tab-body\" aria-labelledby=\"advgb-tabs-tab7\">\n<p><\/p>\n<\/div><\/div>\n\n\n\n<div class=\"wp-block-advgb-tab advgb-tab-body-container\"><div class=\"advgb-tab-body-header advgb-tab-class-undefined\"><\/div><div class=\"advgb-tab-_763019-dc advgb-tab-body\" aria-labelledby=\"advgb-tabs-tab8\">\n<p><\/p>\n<\/div><\/div>\n\n\n\n<div class=\"wp-block-advgb-tab advgb-tab-body-container\"><div class=\"advgb-tab-body-header advgb-tab-class-undefined\"><\/div><div class=\"advgb-tab-_2180af-73 advgb-tab-body\" aria-labelledby=\"advgb-tabs-tab9\">\n<p><\/p>\n<\/div><\/div>\n\n\n\n<div class=\"wp-block-advgb-tab advgb-tab-body-container\"><div class=\"advgb-tab-body-header advgb-tab-class-undefined\"><\/div><div class=\"advgb-tab-_60b929-db advgb-tab-body\" aria-labelledby=\"advgb-tabs-tab10\">\n<p><\/p>\n<\/div><\/div>\n\n\n\n<div class=\"wp-block-advgb-tab advgb-tab-body-container\"><div class=\"advgb-tab-body-header advgb-tab-class-undefined\"><\/div><div class=\"advgb-tab-_88f598-d1 advgb-tab-body\" aria-labelledby=\"advgb-tabs-tab11\">\n<p><\/p>\n<\/div><\/div>\n<\/div><\/div>\n<\/div>\n<\/div>\n<style class=\"advgb-styles-renderer\">.advgb-tabs-45e7bb5a-3898-440a-943a-b75014b5bf64 ul.advgb-tabs-panel li.advgb-tab.advgb-tab-active {background-color:#5954d6 !important;color:#fff !important;}#advgb-tabs-45e7bb5a-3898-440a-943a-b75014b5bf64 .advgb-tab-body-header.header-active, .advgb-tabs-45e7bb5a-3898-440a-943a-b75014b5bf64 .advgb-tab-body-header.header-active{background-color:#5954d6 !important;color:#fff !important;}<\/style>","protected":false},"excerpt":{"rendered":"","protected":false},"author":2,"featu