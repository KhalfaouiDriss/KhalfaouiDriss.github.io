sit Centre<\/a><\/div>\n<\/div>\n<\/div><\/div>\n<\/div><\/div>\n<\/div><\/div><\/div>\n<\/div><\/div>\n\n\n\n<div class=\"wp-block-advgb-column advgb-column advgb-is-half-tablet advgb-is-full-mobile\" id=\"advgb-col-2be968ee-2f56-43d5-9a04-24d5042e5837\"><div class=\"advgb-column-inner\" style=\"border-style:none;border-width:1px\">\n<div class=\"wp-block-advgb-columns advgb-columns-wrapper\" id=\"advgb-cols-1390bbdf-9f71-446a-92fe-7c3877fcd813\"><div class=\"advgb-columns-container\"><div class=\"advgb-columns advgb-columns-row advgb-is-mobile advgb-columns-2 layout-13-23 mbl-layout-stacked vgutter-10\">\n<div class=\"wp-block-advgb-column advgb-column advgb-is-one-third-tablet advgb-is-full-mobile\" id=\"advgb-col-df463723-2c4c-442b-bee7-a72aa3d26853\"><div class=\"advgb-column-inner\" style=\"border-style:none;border-width:1px\">\n<div class=\"wp-block-cover\" style=\"min-height:300px\"><span aria-hidden=\"true\" class=\"wp-block-cover__background has-background-dim-0 has-background-dim\"><\/span><img decoding=\"async\" loading=\"lazy\" width=\"2560\" height=\"1462\" class=\"wp-block-cover__image-background wp-image-11388\" alt=\"\" src=\"https:\/\/aims.edu.gh\/wp-content\/uploads\/sites\/4\/2024\/10\/GSrY6roWkAAjKac-scaled.jpeg\" data-object-fit=\"cover\" srcset=\"https:\/\/aims.edu.gh\/wp-content\/uploads\/sites\/4\/2024\/10\/GSrY6roWkAAjKac-scaled.jpeg 2560w, https:\/\/aims.edu.gh\/wp-content\/uploads\/sites\/4\/2024\/10\/GSrY6roWkAAjKac-300x171.jpeg 300w, https:\/\/aims.edu.gh\/wp-content\/uploads\/sites\/4\/2024\/10\/GSrY6roWkAAjKac-1024x585.jpeg 1024w, https:\/\/aims.edu.gh\/wp-content\/uploads\/sites\/4\/2024\/10\/GSrY6roWkAAjKac-768x439.jpeg 768w, https:\/\/aims.edu.gh\/wp-content\/uploads\/sites\/4\/2024\/10\/GSrY6roWkAAjKac-1536x877.jpeg 1536w, https:\/\/aims.edu.gh\/wp-content\/uploads\/sites\/4\/2024\/10\/GSrY6roWkAAjKac-2048x1170.jpeg 2048w, https:\/\/aims.edu.gh\/wp-content\/uploads\/sites\/4\/2024\/10\/GSrY6roWkAAjKac-18x10.jpeg 18w\" sizes=\"(max-width: 2560px) 100vw, 2560px\" \/><div class=\"wp-block-cover__inner-container\">\n<p class=\"has-text-align-center has-large-font-size\"><\/p>\n<\/div><\/div>\n<\/div><\/div>\n\n\n\n<div class=\"wp-block-advgb-column advgb-column advgb-is-two-thirds-tablet advgb-is-full-mobile\" id=\"advgb-col-ad922013-9c53-44d0-88ae-7befcf11d824\"><div class=\"advgb-column-inner\" style=\"border-style:none;border-width:1px\">\n<div class=\"is-layout-flow wp-block-group pad-5\"><div class=\"wp-block-group__inner-container\">\n<h2>South Africa<\/h2>\n\n\n\n<p>The AIMS Centre of Excellence in South Africa is located in Muizenberg, a small seaside suburb of Cape Town and an area of outstanding natural beauty.<\/p>\n\n\n\n<div style=\"height:20px\" aria-hidden=\"true\" class=\"wp-block-spacer\"><\/div>\n\n\n\n<div class=\"is-layout-flex wp-block-buttons\">\n<div class=\"wp-block-button bg-alt\"><a class=\"wp-block-button__link wp-element-button\">Visit Centre<\/a><\/div>\n<\/div>\n<\/div><\/div>\n<\/div><\/div>\n<\/div><\/div><\/div>\n\n\n\n<div style=\"height:35px\" aria-hidden=\"true\" class=\"wp-block-spacer\"><\/div>\n\n\n\n<div class=\"wp-block-advgb-columns advgb-columns-wrapper\" id=\"advgb-cols-eee89e6b-5fa0-4f7b-9a29-84f12f77af2b\"><div class=\"advgb-columns-container\"><div class=\"advgb-columns advgb-columns-row advgb-is-mobile advgb-columns-2 layout-13-23 mbl-layout-stacked vgutter-10\">\n<div class=\"wp-block-advgb-column advgb-column advgb-is-one-third-tablet advgb-is-full-mobile\" id=\"advgb-col-65643c93-e459-46c3-a317-c6508913caf2\"><div class=\"advgb-column-inner\" style=\"border-style:none;border-width:1px\">\n<div class=\"wp-block-cover is-light\" style=\"min-height:300px\"><span aria-hidden=\"true\" class=\"wp-block-cover__background has-background-dim-0 has-background-dim\"><\/span><img decoding=\"async\" loading=\"lazy\" width=\"900\" height=\"506\" class=\"wp-block-cover__image-background wp-image-11387\" alt=\"\" src=\"https:\/\/aims.edu.gh\/wp-content\/uploads