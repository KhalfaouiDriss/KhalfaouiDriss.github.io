1024w, https:\/\/aims.edu.gh\/wp-content\/uploads\/sites\/4\/2021\/11\/IMG_3788-min-300x200.jpg 300w, https:\/\/aims.edu.gh\/wp-content\/uploads\/sites\/4\/2021\/11\/IMG_3788-min-768x512.jpg 768w, https:\/\/aims.edu.gh\/wp-content\/uploads\/sites\/4\/2021\/11\/IMG_3788-min-1536x1024.jpg 1536w, https:\/\/aims.edu.gh\/wp-content\/uploads\/sites\/4\/2021\/11\/IMG_3788-min-2048x1365.jpg 2048w, https:\/\/aims.edu.gh\/wp-content\/uploads\/sites\/4\/2021\/11\/IMG_3788-min-18x12.jpg 18w\" sizes=\"(max-width: 1024px) 100vw, 1024px\" \/><\/figure><\/li><li class=\"blocks-gallery-item\"><figure><img decoding=\"async\" loading=\"lazy\" width=\"1024\" height=\"683\" src=\"https:\/\/aims.edu.gh\/wp-content\/uploads\/sites\/4\/2021\/11\/IMG_3829-min-1024x683.jpg\" alt=\"\" data-id=\"5912\" data-link=\"https:\/\/aims.edu.gh\/?attachment_id=5912\" class=\"wp-image-5912\" srcset=\"https:\/\/aims.edu.gh\/wp-content\/uploads\/sites\/4\/2021\/11\/IMG_3829-min-1024x683.jpg 1024w, https:\/\/aims.edu.gh\/wp-content\/uploads\/sites\/4\/2021\/11\/IMG_3829-min-300x200.jpg 300w, https:\/\/aims.edu.gh\/wp-content\/uploads\/sites\/4\/2021\/11\/IMG_3829-min-768x512.jpg 768w, https:\/\/aims.edu.gh\/wp-content\/uploads\/sites\/4\/2021\/11\/IMG_3829-min-1536x1024.jpg 1536w, https:\/\/aims.edu.gh\/wp-content\/uploads\/sites\/4\/2021\/11\/IMG_3829-min-2048x1365.jpg 2048w, https:\/\/aims.edu.gh\/wp-content\/uploads\/sites\/4\/2021\/11\/IMG_3829-min-18x12.jpg 18w\" sizes=\"(max-width: 1024px) 100vw, 1024px\" \/><\/figure><\/li><li class=\"blocks-gallery-item\"><figure><img decoding=\"async\" loading=\"lazy\" width=\"1024\" height=\"683\" src=\"https:\/\/aims.edu.gh\/wp-content\/uploads\/sites\/4\/2021\/11\/IMG_4148-min-1024x683.jpg\" alt=\"\" data-id=\"5913\" data-full-url=\"https:\/\/aims.edu.gh\/wp-content\/uploads\/sites\/4\/2021\/11\/IMG_4148-min-scaled.jpg\" data-link=\"https:\/\/aims.edu.gh\/?attachment_id=5913\" class=\"wp-image-5913\" srcset=\"https:\/\/aims.edu.gh\/wp-content\/uploads\/sites\/4\/2021\/11\/IMG_4148-min-1024x683.jpg 1024w, https:\/\/aims.edu.gh\/wp-content\/uploads\/sites\/4\/2021\/11\/IMG_4148-min-300x200.jpg 300w, https:\/\/aims.edu.gh\/wp-content\/uploads\/sites\/4\/2021\/11\/IMG_4148-min-768x512.jpg 768w, https:\/\/aims.edu.gh\/wp-content\/uploads\/sites\/4\/2021\/11\/IMG_4148-min-1536x1024.jpg 1536w, https:\/\/aims.edu.gh\/wp-content\/uploads\/sites\/4\/2021\/11\/IMG_4148-min-2048x1365.jpg 2048w, https:\/\/aims.edu.gh\/wp-content\/uploads\/sites\/4\/2021\/11\/IMG_4148-min-18x12.jpg 18w\" sizes=\"(max-width: 1024px) 100vw, 1024px\" \/><\/figure><\/li><li class=\"blocks-gallery-item\"><figure><img decoding=\"async\" loading=\"lazy\" width=\"1024\" height=\"683\" src=\"https:\/\/aims.edu.gh\/wp-content\/uploads\/sites\/4\/2021\/11\/IMG_4206-min-1024x683.jpg\" alt=\"\" data-id=\"5914\" data-full-url=\"https:\/\/aims.edu.gh\/wp-content\/uploads\/sites\/4\/2021\/11\/IMG_4206-min-scaled.jpg\" data-link=\"https:\/\/aims.edu.gh\/?attachment_id=5914\" class=\"wp-image-5914\" srcset=\"https:\/\/aims.edu.gh\/wp-content\/uploads\/sites\/4\/2021\/11\/IMG_4206-min-1024x683.jpg 1024w, https:\/\/aims.edu.gh\/wp-content\/uploads\/sites\/4\/2021\/11\/IMG_4206-min-300x200.jpg 300w, https:\/\/aims.edu.gh\/wp-content\/uploads\/sites\/4\/2021\/11\/IMG_4206-min-768x512.jpg 768w, https:\/\/aims.edu.gh\/wp-content\/uploads\/sites\/4\/2021\/11\/IMG_4206-min-1536x1024.jpg 1536w, https:\/\/aims.edu.gh\/wp-content\/uploads\/sites\/4\/2021\/11\/IMG_4206-min-2048x1365.jpg 2048w, https:\/\/aims.edu.gh\/wp-content\/uploads\/sites\/4\/2021\/11\/IMG_4206-min-18x12.jpg 18w\" sizes=\"(max-width: 1024px) 100vw, 1024px\" \/><\/figure><\/li><\/ul><\/figure>\n\n\n\n<p>DAY 4 \u2013&nbsp;Industrial Visit to Ghana Tech Lab&nbsp;<\/p>\n\n\n\n<p>Students paid an industrial visit to&nbsp;Ghana Tech Lab, which&nbsp;is an open, collaborative space for competent digital skills training, seeding innovations and growing startups. They were taken through the various works that take place within the space. In groups of relatively small numbers, the students&nbsp;toured&nbsp;the drone building section, the multimedia section, and the 3D modelling section. This exposed&nbsp;them to how to apply hardcore&nbsp;knowledge to&nbsp;industry and problem-solving.&nbsp;<\/p>\n\n\n\n<figure class=\"is-layout-flex wp-block-gallery-5 wp-block-gallery columns-3 is-cropped\"><ul class=\"blocks-gallery-grid\"><li class=\"blocks-gallery-item\"><figure><img decoding=\"async\" loading=\"lazy\" width=\"1024\" height=\"683\" src=\"https:\/\/aims.edu.gh\/wp-content\/uploads\/sites\/4\/2021\/11\/IMG_4300-min-1024x683.jpg\" alt=\"\" data-id=\"5915\" data-link=\"https:\/\/aims.edu.gh\/?attachment_id=5915\" class=\"wp-image-5915\" srcset=\"https:\/\/aims.edu.gh\/wp-content\/uploads\/sites\/4\/2021\/11\/IMG_4300-min-1024x683.jpg 1024w, https:\/\/aims.edu.gh\/wp-content\/uploads\/sites\/4\/2021\/11\/IMG_4300-min-300x200.jpg 300w, https:\/\/aims.edu.gh\/wp-content\/uploads\/sites\/4\/2021\/11\/IMG_4300-min-768x512.jpg 768w, https:\/\/aims.edu.gh\/wp-content\/uploads\/sites\/4\/2021\/11\/IMG_4300-min-1536x1024.jpg 1536w, https:\/\/aims.edu.gh\/wp-content\/uploads\/sites\/4\/2021\/11\/IMG_4300-min-2048x1365.jpg 2048w, https:\/\/aims.edu.gh\/wp-content\/uploads\/sites\/4\/2021\/11\/IMG_4300-min-18x12.jpg 18w\" sizes=\"(max-width: 1024px) 100vw, 1024px\" \/><\/figure><\/li><li class=\"blocks-gallery-item\"><figure><img decoding=\"async\" loading=\"lazy\" width=\"1024\" height=\"683\" src=\"https:\/\/aims.edu.gh\/wp-content\/uploads\/sites\/4\/2021\/11\/IMG_4554-min-1024x683.jpg\" alt=\"\" data-id=\"5917\" data-link=\"https:\/\/aims.edu.gh\/?attachment_id=5917\" class=\"wp-image-5917\" srcset=\"https:\/\/aims.edu.gh\/wp-content\/uploads\/sites\/4\/2021\/11\/IMG_4554-min-1024x683.jpg 1024w, https:\/\/aims.edu.gh\/wp-content\/uploads\/sites\/4\/2021\/11\/IMG_4554-min-300x200.jpg 300w, https:\/\/aims.edu.gh\/wp-content\/uploads\/sites\/4\/2021\/11\/IMG_4554-min-768x512.jpg 768w, https:\/\/aims.edu.gh\/wp-content\/uploads\/sites\/4\/2021\/11\/IMG_4554-min-1536x1024.jpg 1536w, https:\/\/aims.edu.gh\/wp-content\/uploads\/sites\/4\/2021\/11\/IMG_4554-min-2048x1365.jpg 2048w, https:\/\/aims.edu.gh\/wp-content\/uploads\/sites\/4\/2021\/11\/IMG_4554-min-18x12.jpg 18w\" sizes=\"(max-width: 1024px) 100vw, 1024px\" \/><\/figure><\/li><li class=\"blocks-gallery-item\"><figure><img decoding=\"async\" loading=\"lazy\" width=\"1024\" height=\"683\" src=\"https:\/\/aims.edu.gh\/wp-content\/uploads\/sites\/4\/2021\/11\/IMG_4459-min-1024x683.jpg\" alt=\"\" data-id=\"5918\" data-full-url=\"https:\/\/aims.edu.gh\/wp-content\/uploads\/sites\/4\/2021\/11\/IMG_4459-min-scaled.jpg\" data-link=\"https:\/\/aims.edu.gh\/?attachment_id=5918\" class=\"wp-image-5918\" srcset=\"https:\/\/aims.edu.gh\/wp-content\/uploads\/sites\/4\/2021\/11\/IMG_4459-min-1024x683.jpg 1024w, https:\/\/aims.edu.gh\/wp-content\/uploads\/sites\/4\/2021\/11\/IMG_4459-min-300x200.jpg 300w, https:\/\/aims.edu.gh\/wp-content\/uploads\/sites\/4\/2021\/11\/IMG_4459-min-768x512.jpg 768w, https:\/\/aims.edu.gh\/wp-content\/uploads\/sites\/4\/2021\/11\/IMG_4459-min-1536x1024.jpg 1536w, https:\/\/aims.edu.gh\/wp-content\/uploads\/sites\/4\/2021\/11\/IMG_4459-min-2048x1365.jpg 2048w, https:\/\/aims.edu.gh\/wp-content\/uploads\/sites\/4\/2021\/11\/IMG_4459-min-18x12.jpg 18w\" sizes=\"(max-width: 1024px) 100vw, 1024px\" \/><\/figure><\/li><\/ul><\/figure>\n\n\n\n<p>DAY 5 \u2013&nbsp;Community Fact-Finding Mission&nbsp;<\/p>\n\n\n\n<p>On the final day of the E-week, students embarked on a community fact-finding mission&nbsp;where they&nbsp;were divided into eleven groups&nbsp;going&nbsp;round the community to gather facts&nbsp;on&nbsp;common and pressing challenges facing the community. These include poor road systems, crime, poor water supply among others. Problems within the vicinity were discussed by the students after exploring after which they will come up with solutions at the end of the academic year.&nbsp;<\/p>\n\n\n\n<figure class=\"is-layout-flex wp-block-gallery-7 wp-block-gallery columns-3 is-cropped\"><ul class=\"blocks-gallery-grid\"><li class=\"blocks-gallery-item\"><figure><img decoding=\"async\" loading=\"lazy\" width=\"1024\" height=\"683\" src=\"https:\/\/aims.edu.gh\/wp-content\/uploads\/sites\/4\/2021\/11\/IMG_4668-min-1024x683.jpg\" alt=\"\" data-id=\"5919\" data-full-url=\"https:\/\/aims.edu.gh\/wp-content\/uploads\/sites\/4\/2021\/11\/IMG_4668-min-scaled.jpg\" data-link=\"https:\/\/aims.edu.gh\/?attachment_id=5919\" class=\"wp-image-5919\" srcset=\"https:\/\/aims.edu.gh\/wp-content\/uploads\/sites\/4\/2021\/11\/IMG_4668-min-1024x683.jpg 1024w, https:\/\/aims.edu.gh\/wp-content\/uploads\/sites\/4\/2021\/11\/IMG_4668-min-300x200.jpg 300w, https:\/\/aims.edu.gh\/wp-content\/uploads\/sites\/4\/2021\/11\/IMG_4668-min-768x512.jpg 768w, https:\/\/aims.edu.gh\/wp-content\/uploads\/sites\/4\/2021\/11\/IMG_4668-min-1536x1024.jpg 1536w, https:\/\/aims.edu.gh\/wp-content\/uploads\/sites\/4\/2021\/11\/IMG_4668-min-2048x1365.jpg 2048w, https:\/\/aims.edu.gh\/wp-content\/uploads\/sites\/4\/2021\/11\/IMG_4668-min-18x12.jpg 18w\" sizes=\"(max-width: 1024px) 100vw, 1024px\" \/><\/figure><\/li><li class=\"blocks-gallery-item\"><figure><img decoding=\"async\" loading=\"lazy\" width=\"1024\" height=\"768\" src=\"https:\/\/aims.edu.gh\/wp-content\/uploads\/sites\/4\/2021\/11\/IMG_20211015_101334-min-1024x768.jpg\" alt=\"\" data-id=\"5920\" data-full-url=\"https:\/\/aims.edu.gh\/wp-content\/uploads\/sites\/4\/2021\/11\/IMG_20211015_101334-min-scaled.jpg\" data-link=\"https:\/\/aims.edu.gh\/?attachment_id=5920\" class=\"wp-image-5920\" srcset=\"https:\/\/aims.edu.gh\/wp-content\/uploads\/sites\/4\/2021\/11\/IMG_20211015_101334-min-1024x768.jpg 1024w, https:\/\/aims.edu.gh\/wp-content\/uploads\/sites\/4\/2021\/11\/IMG_20211015_101334-min-300x225.jpg 300w, https:\/\/aims.edu.gh\/wp-content\/uploads\/sites\/4\/2021\/11\/IMG_20211015_101334-min-768x576.jpg 768w, https:\/\/aims.