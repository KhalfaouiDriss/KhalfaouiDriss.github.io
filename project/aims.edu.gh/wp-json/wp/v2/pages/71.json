"relative_dates":{"created":"Posted 5 years ago","modified":"Updated 8 months ago"},"absolute_dates":{"created":"Posted on September 19, 2020","modified":"Updated on March 20, 2025"},"absolute_dates_time":{"created":"Posted on September 19, 2020 5:07 pm","modified":"Updated on March 20, 2025 1:45 pm"},"featured_img_caption":"","featured_img":false,"series_order":"","_links":{"self":[{"href":"https:\/\/aims.edu.gh\/wp-json\/wp\/v2\/pages\/71"}],"collection":[{"href":"https:\/\/aims.edu.gh\/wp-json\/wp\/v2\/pages"}],"about":[{"href":"https:\/\/aims.edu.gh\/wp-json\/wp\/v2\/types\/page"}],"author":[{"embeddable":true,"href":"https:\/\/aims.edu.gh\/wp-json\/wp\/v2\/users\/1"}],"replies":[{"embeddable":true,"href":"https:\/\/aims.edu.gh\/wp-json\/wp\/v2\/comments?post=71"}],"version-history":[{"count":79,"href":"https:\/\/aims.edu.gh\/wp-json\/wp\/v2\/pages\/71\/revisions"}],"predecessor-version":[{"id":12352,"href":"https:\/\/aims.edu.gh\/wp-json\/wp\/v2\/pages\/71\/revisions\/12352"}],"wp:attachment":[{"href":"https:\/\/aims.edu.gh\/wp-json\/wp\/v2\/media?parent=71"}],"curies":[{"name":"wp","href":"https:\/\/api.w.org\/{rel}","templated":true}]}}